{
  "name": "visual-assets",
  "version": "0.0.0",
  "private": true,
  "description": "고등학교 정보 교과 수업용 웹 강의노트와 시뮬레이터. 모든 명령은 이곳에만 정의한다 — 스크립트 경로를 직접 치지 않는다. 검사·감사 목록은 tools/run.mjs 에만 있다.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run docx",
    "ci": "npm run check && npm run build && npm run check -- dist",
    "check": "node tools/run.mjs check",
    "audit": "node tools/run.mjs audit",
    "gen:graph": "node tools/gen_graph_presets.mjs 12",
    "gen:sim-index": "node tools/checks/sim-index.mjs",
    "prose": "node tools/extract-prose.mjs",
    "docx": "node tools/docx/build.js",
    "mutate": "node tools/mutate.mjs"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "autoprefixer": "^10.5.4",
    "chart.js": "^4.5.1",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "docx": "^9.7.0",
    "entities": "^8.1.0",
    "jsdom": "^30.0.1",
    "mathjax": "^3.2.2",
    "ml5": "^1.3.1",
    "p5": "^1.9.0",
    "postcss": "^8.5.26",
    "pretendard": "^1.3.9",
    "prismjs": "^1.29.0",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.1",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
