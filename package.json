{
  "name": "visual-assets",
  "version": "0.0.0",
  "private": true,
  "description": "고등학교 정보·인공지능 수업용 웹 강의안과 시뮬레이터. 명령은 여기 한 곳에만 정의한다 — 스크립트 경로를 직접 치지 않는다.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:vite && npm run build:legacy",
    "ci": "npm run check && npm run build && npm run check:dist",
    "setup": "npm --prefix tools/docx ci && npm --prefix .github/scripts ci",
    "build:vite": "vite build",
    "build:legacy": "python .github/scripts/build_site.py --out dist",
    "check": "npm run check:classes && npm run check:code",
    "check:classes": "python tools/check_dynamic_classes.py",
    "check:code": "python tools/check_code.py",
    "check:dist": "python tools/check_dist.py dist",
    "check:html": "python tools/check_html.py",
    "check:inject": "python .github/scripts/inject_code.py --self-test",
    "audit:pre": "python tools/audit_pre.py",
    "audit:svg": "python tools/audit_svg_maxwidth.py",
    "prose": "python tools/extract_prose.py",
    "docx": "node tools/docx/build.js"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "pretendard": "^1.3.9",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.1"
  },
  "type": "module"
}
