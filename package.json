{
  "name": "visual-assets",
  "version": "0.0.0",
  "private": true,
  "description": "고등학교 정보 교과 수업용 웹 강의노트와 시뮬레이터. 모든 명령은 이곳에만 정의한다 — 스크립트 경로를 직접 치지 않는다.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run docx",
    "ci": "npm run check && npm run build && npm run check:dist",
    "check": "npm run check:classes && npm run check:code && npm run check:html && npm run check:graph && npm run check:graph-sim && npm run check:puzzle && npm run check:sort && npm run check:ds && npm run check:tree && npm run check:find && npm run check:sims && npm run check:deep-learning",
    "check:classes": "python tools/check_dynamic_classes.py",
    "check:code": "python tools/check_code.py",
    "check:deep-learning": "node tools/check_deep_learning.mjs",
    "check:dist": "python tools/check_dist.py dist",
    "check:graph": "node tools/check_graph_presets.mjs",
    "check:graph-sim": "node tools/check_graph_sims.mjs",
    "check:puzzle": "node tools/check_puzzle_heuristic.mjs",
    "check:sims": "node tools/check_sims.mjs",
    "check:sort": "node tools/check_sort.mjs",
    "check:ds": "node tools/check_ds.mjs",
    "check:find": "node tools/check_find.mjs",
    "check:tree": "node tools/check_tree.mjs",
    "check:html": "python tools/check_html.py",
    "check:stale": "python tools/check_stale_refs.py",
    "gen:graph": "node tools/gen_graph_presets.mjs 12",
    "audit:pre": "python tools/audit_pre.py",
    "audit:svg": "python tools/audit_svg_maxwidth.py",
    "audit:narrow": "python tools/audit_narrow.py",
    "audit:josa": "python tools/audit_josa.py",
    "prose": "python tools/extract_prose.py",
    "docx": "node tools/docx/build.js"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "autoprefixer": "^10.5.4",
    "chart.js": "^4.5.1",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "docx": "^9.7.0",
    "mathjax": "^3.2.2",
    "ml5": "^1.3.1",
    "p5": "^1.9.0",
    "postcss": "^8.5.26",
    "pretendard": "^1.3.9",
    "prismjs": "^1.29.0",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.1"
  },
  "type": "module"
}
